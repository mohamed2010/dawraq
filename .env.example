# Database Connection (Direct/Pooler URI for Drizzle ORM)
# Set this securely in Vercel or your local secret store; never commit it.
DATABASE_URL=postgresql://database-user:database-password@database-host:6543/database-name

# Session Secret
# Generate a unique random value with at least 32 characters. Never reuse this example.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
NODE_ENV=production
